# Copy this file to ai_system/.env and fill in your values before running docker-compose.
# Using Groq (free tier, high rate limits): https://console.groq.com
GROQ_API_KEY=gsk-...
# Groq models: llama-3.1-70b-versatile (recommended for financial analysis), llama-3.1-8b-instant (fast but limited)
GROQ_MODEL=llama-3.1-70b-versatile
# Copy this file to ai_system/.env and fill in real secret values.
OPENAI_API_KEY=sk-your-openai-key
OPENAI_API_KEY_BACKUP=sk-your-backup-openai-key
LANGSMITH_API_KEY=lsv2-your-langsmith-key
